APP_NAME=Online Teaching Academy Management & Learning Platform
ENVIRONMENT=development

# Dev: sqlite:///./app.db
# Prod: postgresql+psycopg://user:password@host:5432/dbname
DATABASE_URL=sqlite:///./app.db

JWT_SECRET=replace-with-a-long-random-secret
JWT_ALGORITHM=HS256
JWT_ACCESS_EXPIRE_MINUTES=15
JWT_REFRESH_EXPIRE_DAYS=14

CORS_ORIGINS=["http://localhost:5173"]

FRONTEND_URL=http://localhost:5173
REQUIRE_EMAIL_VERIFICATION=false

SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_USE_TLS=true

WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_API_VERSION=v21.0
WHATSAPP_API_BASE_URL=https://graph.facebook.com
WHATSAPP_TEMPLATE_NAME=school_notification
WHATSAPP_TEMPLATE_LANGUAGE=en_US

JAZZCASH_MERCHANT_ID=
JAZZCASH_PASSWORD=
JAZZCASH_INTEGRITY_SALT=
JAZZCASH_CHECKOUT_URL=https://sandbox.jazzcash.com.pk/CustomerPortal/transactionmanagement/merchantform/
JAZZCASH_INQUIRY_URL=https://sandbox.jazzcash.com.pk/ApplicationAPI/API/2.0/Inquiry/OnlineInquiry
JAZZCASH_RETURN_URL=http://localhost:8000/api/v1/fees/gateway/jazzcash/callback
JAZZCASH_VERSION=1.1
JAZZCASH_TXN_TYPE=MWALLET
JAZZCASH_BANK_ID=TBANK
JAZZCASH_PRODUCT_ID=RETL
JAZZCASH_TXN_EXPIRY_MINUTES=60

TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_SMS_FROM=

JITSI_APP_ID=
JITSI_JWT_SECRET=
# Hostname only — no scheme, no trailing slash.
# Leave as meet.jit.si for the free public server, or set your self-hosted domain.
JITSI_DOMAIN=meet.jit.si

# Google Calendar API (Google Meet link generation) — see setup steps in the project README.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/v1/integrations/google-calendar/callback
GOOGLE_CALENDAR_ID=primary
